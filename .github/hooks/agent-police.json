{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node \"$(git rev-parse --show-toplevel)/.agent-police/bin/agent-police.mjs\" hook copilot-prompt",
        "powershell": "node \"$(git rev-parse --show-toplevel)/.agent-police/bin/agent-police.mjs\" hook copilot-prompt",
        "timeoutSec": 60
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"$(git rev-parse --show-toplevel)/.agent-police/bin/agent-police.mjs\" hook copilot-pretool",
        "powershell": "node \"$(git rev-parse --show-toplevel)/.agent-police/bin/agent-police.mjs\" hook copilot-pretool",
        "timeoutSec": 60
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "node \"$(git rev-parse --show-toplevel)/.agent-police/bin/agent-police.mjs\" hook copilot-stop",
        "powershell": "node \"$(git rev-parse --show-toplevel)/.agent-police/bin/agent-police.mjs\" hook copilot-stop",
        "timeoutSec": 900
      }
    ]
  }
}
